# SkillConnect production environment
# Set these in your hosting provider's Environment Variables / Secrets.
PORT=10000
NODE_ENV=production

MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/skillconnect?retryWrites=true&w=majority

JWT_ACCESS_SECRET=<LONG_RANDOM_ACCESS_SECRET>
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=<DIFFERENT_LONG_RANDOM_REFRESH_SECRET>
JWT_REFRESH_EXPIRES_IN=7d

SMTP_USER=<SMTP_USERNAME>
SMTP_PASS=<SMTP_PASSWORD>
SMTP_FROM_EMAIL=SkillConnect <your-verified-sender@example.com>
